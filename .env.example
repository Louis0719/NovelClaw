# =============================================================================
# Global Environment Variables Template
# Copy this file to .env for each project directory
# NEVER commit .env files or any file containing real API keys
# =============================================================================

# MiniMax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_group_id_here
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 腾讯混元
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
TENCENT_REGION=ap-guangzhou

# OpenAI / 代理API
OPENAI_API_KEY=your_openai_api_key_here
IMG_API_KEY=your_image_api_key_here
IMG_API_BASE=https://api.ohmygpt.com

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (optional)
MONGODB_URL=mongodb://localhost:27017
