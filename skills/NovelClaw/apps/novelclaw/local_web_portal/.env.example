# NovelClaw 服务配置
APP_SESSION_SECRET=         #必须与 auth-portal 的 APP_SESSION_SECRET 相同
APP_SESSION_COOKIE_NAME=session
APP_AUTH_DATABASE_URL=sqlite:///../auth-portal/local_web_portal/data/app.db
APP_DATABASE_URL=sqlite:///./data/app.db
APP_AGENT_API_KEY=         #Agent API 密钥（随机字符串，用于保护 /api/v1/* 接口）
WEB_MODELLESS_MODE=0
WEB_DEFAULT_PROVIDER=deepseek
WEB_BUILTIN_PROVIDERS=deepseek,openai,codex
EMBEDDING_MODEL=none
DISABLE_EMBEDDING_DOWNLOADS=1
LOG_LEVEL=INFO
WEB_MAX_ITERATIONS=8
WEB_MAX_TOTAL_ITERATIONS=16

# LLM Provider 配置（DeepSeek 为默认，内置支持 openai/codex）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
CODEX_BASE_URL=https://codex-api.packycode.com/v1
CODEX_MODEL=gpt-5.2
# 如需使用 MiniMax：通过 Web UI 的 Models 页面手动添加，或创建后通过 API 注册
